{
  "name": "react-native-responsive-image-view",
  "version": "3.0.0",
  "private": false,
  "description": "React Native component for scaling an Image within the parent View",
  "keywords": [
    "aspect-ratio",
    "fit",
    "flexible",
    "hook",
    "image",
    "react",
    "react-native",
    "responsive",
    "view"
  ],
  "homepage": "https://npm.im/react-native-responsive-image-view",
  "bugs": {
    "url": "https://github.com/wKovacs64/react-native-responsive-image-view/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/react-native-responsive-image-view.git"
  },
  "source": "src/index.tsx",
  "files": [
    "src",
    "dist/commonjs",
    "dist/module",
    "dist/typescript/src",
    "!**/__fixtures__",
    "!**/__tests__"
  ],
  "type": "module",
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf coverage dist",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install",
    "changeset:publish": "changeset publish",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepack": "bob build",
    "prepublishOnly": "run-p --silent lint test",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@wkovacs64/oxlint-config": "0.2.2",
    "babel-jest": "30.5.1",
    "doctoc": "2.5.0",
    "jest": "30.5.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.0",
    "rimraf": "6.1.3",
    "test-renderer": "1.2.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": ">=16.8.3",
    "react-native": ">=0.59.0"
  },
  "packageManager": "pnpm@11.25.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
